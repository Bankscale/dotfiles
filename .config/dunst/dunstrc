[global]
    font = "Product Sans 10"

    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    ellipsize = end
    show_age_threshold = -1
    word_wrap = yes
    ignore_newline = no

    ### Geometry ###
    width = 340
    height = (0, 300)
    origin = top-right
    offset = (10, 10)

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 0
    progress_bar_min_width = 120
    progress_bar_max_width = 280

    ### Appearance ###
    frame_width = 0
    corner_radius = 10
    transparency = 8

    separator_height = 0

    padding = 14
    horizontal_padding = 14
    text_icon_padding = 12
    line_height = 0

    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    idle_threshold = 0
    monitor = 0
    follow = keyboard
    show_indicators = no
    sticky_history = yes
    always_run_script = true

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all


### Scripts ###
[songArtLogger]
    script = ~/.config/dunst/scripts/songArtLogger.sh


### Urgency Levels ###

[urgency_low]
    timeout = 5
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    highlight = "#74c7ec"

[urgency_normal]
    timeout = 6
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    highlight = "#89b4fa"

[urgency_critical]
    timeout = 0
    background = "#1e1e2e"
    foreground = "#ffffff"
    highlight = "#f38ba8"


### Custom Rules ###

[backlight]
    summary = "Backlight"
    highlight = "#fab387"
    set_stack_tag = "backlight"

[volume]
    summary = "Volume"
    set_stack_tag = "volume"

[volume-muted]
    summary = "Volume Muted"
    highlight = "#f38ba8"

[volume-unmuted]
    summary = "Volume Unmuted"
    highlight = "#a6e3a1"

